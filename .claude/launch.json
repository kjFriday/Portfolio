{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ticket-tracker",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8710", "--bind", "127.0.0.1", "--directory", "simple_ticket_tracker/www"],
      "port": 8710
    },
    {
      "name": "cms",
      "runtimeExecutable": "go",
      "runtimeArgs": ["-C", "content_management_system", "run", ".", "-serve"],
      "port": 8720
    },
    {
      "name": "cms-public",
      "runtimeExecutable": "go",
      "runtimeArgs": ["-C", "content_management_system", "run", ".", "-public", "-addr", "127.0.0.1:8721"],
      "port": 8721
    },
    {
      "name": "notify",
      "runtimeExecutable": "go",
      "runtimeArgs": ["-C", "notification_and_message_hub", "run", "./cmd/notify", "-serve"],
      "port": 8730
    },
    {
      "name": "data-dash",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8711", "--bind", "127.0.0.1", "--directory", "data_dash/www"],
      "port": 8711
    }
  ]
}
