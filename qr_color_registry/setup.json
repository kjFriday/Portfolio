{
  "id": "GenericCompany.QRPalette",
  "name": "Generic Company QR Palette",
  "version": "0.1.0",
  "publisher": "Generic Company Inc. (fictional)",
  "group": "Generic Company Inc",
  "icon": "icon/app.ico",
  "license": "LICENSE",
  "files": [
    {"from": "qr_palette.py"},
    {"from": "qr_codec.py"},
    {"from": "swatch.py"},
    {"from": "algos.py"},
    {"from": "ranking.py"},
    {"from": "registry.py"},
    {"from": "settings.py"},
    {"from": "textsafe.py"},
    {"from": "local_inference.py"},
    {"from": "ecp.py"},
    {"from": "mcp_server.py"},
    {"from": "audit.py"},
    {"from": "shortlinks.py"},
    {"from": "planner.json"},
    {"from": "links.json"},
    {"from": "settings.example.json"},
    {"from": "presets", "to": "presets"},
    {"from": "weights", "to": "weights"},
    {"from": "icon", "to": "icon"},
    {"from": "README.md"},
    {"from": "ECP.md"}
  ],
  "exclude": ["__pycache__", "*.pyc"],
  "run": {"program": "{python}", "args": ["{app}\\qr_palette.py"], "appUserModelId": "GenericCompany.QRPalette"},
  "requires": {"python": "3.10"},
  "askFolder": true,
  "shortcuts": {"ask": true, "startMenu": true, "desktop": false},
  "purge": ["{localappdata}\\Generic Company Inc\\GenericCompany.QRPalette"],
  "output": "dist/{name}-{version}-setup.exe"
}
